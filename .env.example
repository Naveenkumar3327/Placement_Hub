# Database Configuration
MONGODB_URI=mongodb://localhost:27017/placement_portal

# Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Configuration
# Supported: "gemini" | "openai" (defaults to intelligent built-in heuristic/hybrid engine if no key provided)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudinary / File Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
