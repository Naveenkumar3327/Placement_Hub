# Database Configuration
MONGODB_URI=mongodb://localhost:27017/placement_portal

# Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Configuration
# Supported: "gemini" | "openai" | "huggingface" (uses local ATS writer if no key is available)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hugging Face Inference Providers (resume generation and optional speech transcript translation)
HUGGINGFACE_API_TOKEN=

# Optional Kaggle API credentials for private/rate-limited datasets
KAGGLE_USERNAME=
KAGGLE_KEY=

# Cloudinary / File Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
